{
  "name": "watch17",
  "version": "1.0.0",
  "description": "WATCH17 - streaming film & series (scraper 7reels) as a Cloudflare Worker",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "check": "node test/selfcheck.js && node test/rendercheck.js && node test/workercheck.js",
    "check:render": "node test/rendercheck.js",
    "check:worker": "node test/workercheck.js"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.63.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.52.5"
  },
  "optionalDependencies": {
    "wrangler": "^4.14.0"
  }
}
