{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "watch17",
    "main": "worker/index.js",
    "compatibility_date": "2025-09-01",
    "workers_dev": true,
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
    },
    "observability": {
        "enabled": true
    }
}
